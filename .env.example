# Copy to .env and fill in what you need. Every variable is optional: the defaults
# work against the local `docker compose` stack, and the offline tests need none.

# Postgres with PostGIS and pgvector (docker-compose.yml: role and database `ingovo`).
DATABASE_URL=postgresql+asyncpg://ingovo@localhost:5432/ingovo

# Redis for the session store, caches and rate limits. Leave empty to use an
# in-process memory cache (one worker only; rate limiting is then off).
REDIS_URL=redis://localhost:6379/0

# Model providers. The parser, the rerank and the photo reading use Gemini; query
# and listing embeddings use Cohere (embed-multilingual-v3.0, 1024 dimensions).
GEMINI_API_KEY=
COHERE_API_KEY=

# HMAC key for the anonymous session cookie, at least 32 characters. Required when
# ENV=production; otherwise a per-process key is generated when it is empty.
SESSION_SIGNING_KEY=

# development | production | test
ENV=development

# Comma-separated browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted reverse proxies in front of the app (how far into X-Forwarded-For to read).
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Optional LLM work (narratives, then the rerank) switches off as the day's logged
# model spend approaches this many US dollars. 0 disables the guard.
LLM_DAILY_BUDGET_USD=25

# Search tuning
AI_SEARCH_CONDITIONAL_RERANK=true
AI_SEARCH_RERANK_RANK_ONLY=false
AI_SEARCH_PARSER_TIMEOUT_MS=2500
AI_SEARCH_IMAGE_TIMEOUT_MS=15000
AI_SEARCH_RERANK_TIMEOUT_MS=3500
AI_SEARCH_NARRATOR_TIMEOUT_MS=6000

# Reranker: gemini | jev | shadow | canary | off. `jev` and friends need a TypeSafe
# key and fall back to the Gemini rerank without one.
AI_SEARCH_RERANK_BACKEND=gemini
TYPESAFE_API_KEY=
AI_SEARCH_RERANK_JEV_PERCENT=0
AI_SEARCH_RERANK_JEV_TIMEOUT_MS=1200
AI_SEARCH_RERANK_JEV_COOLDOWN_S=60
AI_SEARCH_RERANK_SHADOW_SAMPLE=1.0
